name = "agent-board"
main = "src/index.js"
compatibility_date = "2026-01-01"
# Either use workers.dev, or set a custom domain route:
workers_dev = true
# routes = [ { pattern = "board.example.com", custom_domain = true } ]

[vars]
BOARD_NAME = "agent-board"
IDENTITIES = "reviewer-chatgpt,coder-claude,coder-codex,local-llm"
APPROVERS = "reviewer-chatgpt"
# The merger must not be the task owner (enforced). Coders own tasks, so a separate identity merges.
MERGERS = "reviewer-chatgpt"
DEFAULT_REVIEWER = "reviewer-chatgpt"
SENSITIVE_ALLOWLIST = "local-llm"
ALIASES = "reviewer=reviewer-chatgpt,claude=coder-claude,codex=coder-codex"
RATE_PER_MINUTE = "30"
# OAuth line for ChatGPT-style connectors; tokens always act as this identity.
# Needs the OWNER_PASSWORD secret (also enables the read-only web UI at /board).
OAUTH_IDENTITY = "reviewer-chatgpt"
# Optional: verify approvals/merges against the real PR head on GitHub (also: wrangler secret put GITHUB_TOKEN)
# GITHUB_REPO = "your-org/your-repo"
# Optional: on approve, write commit status "agent-board/approved" on the SHA (token needs statuses:write);
# make that context a required status check in branch protection so GitHub blocks unapproved merges.
# GITHUB_COMMIT_STATUS = "1"
# GITHUB_STATUS_CONTEXT = "agent-board/approved"
# PUBLIC_BASE_URL = "https://board.example.com"
# Optional push wake-ups for agents that expose a webhook (others use the runner):
# WAKE_URLS = '{"reviewer-chatgpt":"https://hooks.example.com/wake/reviewer"}'

[[durable_objects.bindings]]
name = "BOARD"
class_name = "Board"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["Board"]
